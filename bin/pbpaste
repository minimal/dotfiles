#!/bin/sh
# Clipboard paste. Use macOS pbpaste on Darwin, else WSL PowerShell.
# Windows dirs are not on PATH, so use full path.
# -NoProfile skips the PowerShell startup profile. Strip Windows CRLF.
[ "$(uname)" = Darwin ] && exec /usr/bin/pbpaste
/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -Command 'Get-Clipboard' | tr -d '\r'
